{
  "name": "gaple-3d-online",
  "version": "1.0.0",
  "description": "Gaple 3D Real-time Multiplayer with PostgreSQL and Socket.IO",
  "scripts": {
    "dev": "concurrently -n \"SERVER,NEXT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "next dev -p 3005",
    "dev:server": "tsx watch server/index.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -n \"SERVER,NEXT\" -c \"magenta,cyan\" \"npm run start:server\" \"npm run start:web\"",
    "start:web": "next start -p 3005",
    "start:server": "tsx server/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cookie": "^1.0.1",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
